# Port this service listens on
AI_SERVICE_PORT=8000
# Shared secret the Node backend sends in the X-Internal-Key header
AI_INTERNAL_KEY=change-me
# LLM providers used by the existing RAG pipeline (sarvam_client.py)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1
GROQ_API_KEY=
# Optional: where the Chroma index lives (defaults to ./chroma_db)
# CHROMA_PATH=
