# Copy to backend/.env and fill in. backend/.env is gitignored.

# Server
PORT=5000
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change_me_to_a_random_string

# AI providers (at least one required for /api/v1/ask)
SARVAM_API_KEY=
GROQ_API_KEY=

# Storage
DB_PATH=users.db
CHROMA_PATH=chroma_db
LOG_FILE=metrics.log

# RAG
RELEVANCE_THRESHOLD=0.65
SARVAM_TIMEOUT_SECONDS=15
